# Copy to an ignored environment file; preserve your existing DATABASE_URL.
# Next.js and Prisma use .env.development.local during local development.
DATABASE_URL=
BETTER_AUTH_URL=http://localhost:3000
# Use a random secret of at least 32 characters. Never commit real secrets.
BETTER_AUTH_SECRET=
# Replace these empty values with your Google Web application OAuth credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

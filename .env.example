# Copy to an ignored environment file; preserve your existing DATABASE_URL.
# Next.js and Prisma use .env.development.local during development.
# dev:prisma uses this hosted Prisma Postgres URL (postgresql:// or postgres://).
# dev:local overrides DATABASE_URL with the Docker database automatically.
DATABASE_URL=
BETTER_AUTH_URL=http://localhost:3000
# Use a random secret of at least 32 characters. Never commit real secrets.
BETTER_AUTH_SECRET=
# Replace these empty values with your Google Web application OAuth credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
